<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>SekiroParamMerger</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!--
      WFO1000 is a .NET 9 WinForms analyzer ERROR raised on any public property of a
      Control-derived class that doesn't declare DesignerSerializationVisibility.
      Our custom controls (RoundedPanel, ModernButton, RoundTitleButton, ...) expose
      runtime-styled properties that should never be serialized by the visual designer,
      so we suppress it project-wide (the properties already carry the attribute).
    -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SekiroParamMerger.Core\SekiroParamMerger.Core.csproj" />
  </ItemGroup>

</Project>
